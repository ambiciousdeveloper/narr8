function StoryCard({ ep, parentLastSync, isSynthesizing, isAnalyzing, onSynthesize, onDrillDown, onSubAnalyze, onExpand, lang, t }: any) {
    const [isFlipped, setIsFlipped] = useState(ep.is_synthesized);
    const isStale = parentLastSync && ep.created_at < parentLastSync;

    // [개선] 각색 완료 시 자동으로 뒷면(Creative Vision)으로 뒤집기
    useEffect(() => {
        if (ep.is_synthesized && !isSynthesizing) {
            setIsFlipped(true);
        }
    }, [ep.is_synthesized, isSynthesizing]);

    return (
        <div className="perspective-1000 w-full h-[450px]">
            <motion.div
                initial={false}
                animate={{ rotateY: isFlipped ? 180 : 0 }}
                transition={{ duration: 0.6, type: 'spring' }}
                className="relative w-full h-full preserve-3d"
            >
                {/* Front: Original */}
                <div className="absolute inset-0 backface-hidden bg-white/5 border border-white/10 rounded-3xl p-8 flex flex-col">
                    <div className="flex justify-between items-start mb-6">
                        <div className="flex flex-col gap-1">
                            <span className="text-[10px] font-bold text-purple-400/60 uppercase tracking-widest">
                                Original (Level {ep.hierarchy_group})
                            </span>
                            {isStale && (
                                <span className="flex items-center gap-1 text-[9px] font-bold text-yellow-500 uppercase">
                                    <AlertTriangle className="w-3 h-3" /> Context Changed
                                </span>
                            )}
                        </div>
                        <div className="flex gap-2">
                            <button onClick={() => onExpand('original')} className="p-1.5 hover:bg-white/10 rounded-lg">
                                <Maximize2 className="w-4 h-4 text-gray-400" />
                            </button>
                            {ep.is_synthesized && (
                                <button onClick={() => setIsFlipped(true)} className="p-1.5 bg-purple-500/10 rounded-lg">
                                    <CheckCircle className="w-4 h-4 text-purple-400" />
                                </button>
                            )}
                        </div>
                    </div>
                    <h3 className="text-2xl font-bold mb-4 leading-tight">{ep.unit_title_kr}</h3>
                    <div className="flex-1 overflow-hidden">
                        <p className="text-sm text-gray-400 leading-relaxed italic line-clamp-6">
                            "{ep.original_body_kr}"
                        </p>
                    </div>
                    <div className="mt-8 flex gap-2">
                        <button
                            onClick={onSynthesize}
                            disabled={isSynthesizing || isAnalyzing}
                            className={`flex-1 py-4 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 transition-all shadow-lg ${ep.is_synthesized
                                ? 'bg-white/10 text-gray-400 border border-white/10 hover:bg-white/20'
                                : 'bg-purple-600 hover:bg-purple-500 disabled:bg-purple-900/50 shadow-purple-900/20'
                                }`}
                        >
                            {isSynthesizing ? <Loader2 className="w-5 h-5 animate-spin" /> : (ep.is_synthesized ? <Wand2 className="w-5 h-5" /> : <Sparkles className="w-5 h-5" />)}
                            {ep.is_synthesized ? (lang === 'KO' ? '다시 각색하기' : 'Re-Synthesize') : (lang === 'KO' ? '이 스토리 각색하기' : 'Synthesize story')}
                        </button>
                        {ep.is_synthesized && (
                            <button
                                onClick={() => setIsFlipped(true)}
                                className="px-4 py-4 bg-purple-600 hover:bg-purple-500 rounded-2xl transition-all shadow-lg shadow-purple-900/20"
                                title="각색 결과 보기"
                            >
                                <ArrowRight className="w-5 h-5 text-white" />
                            </button>
                        )}
                    </div>
                </div>

                {/* Back: Creative */}
                <div className="absolute inset-0 backface-hidden bg-[#1a1625] border border-purple-500/40 rounded-3xl p-8 flex flex-col rotate-y-180 shadow-2xl">
                    <div className="flex justify-between items-start mb-6">
                        <span className="text-[10px] font-bold text-purple-400 uppercase tracking-widest flex items-center gap-2">
                            Creative Vision
                        </span>
                        <div className="flex gap-2">
                            {ep.source_metadata?.adaptation_reasoning && (
                                <button
                                    onClick={() => onExpand('reasoning')}
                                    className="p-1.5 bg-yellow-500/10 hover:bg-yellow-500/20 rounded-lg group relative"
                                    title="AI 각색 근거 보기"
                                >
                                    <MessageSquare className="w-4 h-4 text-yellow-500" />
                                </button>
                            )}
                            <button onClick={() => onExpand('creative')} className="p-1.5 hover:bg-white/10 rounded-lg">
                                <Maximize2 className="w-4 h-4 text-purple-400" />
                            </button>
                            <button onClick={() => setIsFlipped(false)} className="p-1.5 hover:bg-white/10 rounded-lg border border-white/5">
                                <History className="w-4 h-4 text-gray-400" />
                            </button>
                        </div>
                    </div>
                    <h3 className="text-2xl font-bold mb-4 text-purple-300">{ep.unit_title_kr}</h3>
                    <div className="flex-1 overflow-y-auto custom-scrollbar pr-2 mb-6">
                        <p className="text-sm text-gray-200 leading-relaxed whitespace-pre-wrap">
                            {ep.synthesized_body_kr || (isSynthesizing ? '창작 중...' : '각색된 내용이 없습니다.')}
                        </p>
                    </div>
                    <div className="flex gap-3">
                        {ep.hierarchy_group !== 'L3' ? (
                            <button
                                onClick={onSubAnalyze}
                                disabled={isAnalyzing || isSynthesizing}
                                className="flex-1 py-4 bg-white/10 hover:bg-white/20 disabled:opacity-30 disabled:cursor-not-allowed rounded-2xl font-bold text-sm flex items-center justify-center gap-2 transition-all border border-white/5"
                            >
                                {isAnalyzing ? <Loader2 className="w-4 h-4 animate-spin text-purple-400" /> : <Search className="w-4 h-4 text-purple-400" />}
                                {lang === 'KO' ? '추가 분석' : 'Sub Analyze'}
                            </button>
                        ) : (
                            <button className="flex-1 py-4 bg-green-600/20 text-green-400 rounded-2xl font-bold text-sm border border-green-500/20">
                                최종 단계 (L3)
                            </button>
                        )}
                        <button
                            onClick={onDrillDown}
                            disabled={isAnalyzing || isSynthesizing}
                            className="p-4 bg-purple-600 hover:bg-purple-500 disabled:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed rounded-2xl transition-all shadow-lg shadow-purple-900/20"
                        >
                            <ArrowRight className="w-5 h-5 text-white" />
                        </button>
                    </div>
                </div>
            </motion.div>
        </div>
    );
}
